\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \texttt  {hit\_rate} e falso positivo (\texttt  {normal\_alert\_rate}) ao longo da evolução do candidato. O EXP15b supera o candidato anterior (task~14) nos dois eixos simultaneamente... exceto pelo FP, que sobe $\sim $37\% relativo (0,22\%$\to $0,30\%) -- ainda assim bem abaixo do teto do AutoML (0,35\%).\relax }}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:comparativo}{{3}{9}{\texttt {hit\_rate} e falso positivo (\texttt {normal\_alert\_rate}) ao longo da evolução do candidato. O EXP15b supera o candidato anterior (task~14) nos dois eixos simultaneamente... exceto pelo FP, que sobe $\sim $37\% relativo (0,22\%$\to $0,30\%) -- ainda assim bem abaixo do teto do AutoML (0,35\%).\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Estudo de caso: o episódio de 2026-04-14}{9}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Episódio 2026-04-14: temperatura bruta (topo) e erro de reconstrução dos dois candidatos (base), com os respectivos thresholds. Note que os dois eixos de MAE não são diretamente comparáveis em escala absoluta -- a normalização de entrada mudou entre os dois candidatos -- o que importa é a posição de cada curva \emph  {relativa ao seu próprio} threshold.\relax }}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:caso0414}{{4}{10}{Episódio 2026-04-14: temperatura bruta (topo) e erro de reconstrução dos dois candidatos (base), com os respectivos thresholds. Note que os dois eixos de MAE não são diretamente comparáveis em escala absoluta -- a normalização de entrada mudou entre os dois candidatos -- o que importa é a posição de cada curva \emph {relativa ao seu próprio} threshold.\relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Classificação dos alarmes por qualidade de detecção}{10}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Classificação automática dos 40 alarmes do período OOS por qualidade de detecção (metodologia de antecedência descrita no texto). Dos 40 alarmes, 4 são falhas confirmadas de comunicação/instrumento (\texttt  {Comm Fail}/\texttt  {Out of Serv} no dado bruto do SCADA), sem precursor físico esperado -- não removidos desta contagem para manter a comparação simples, mas documentados em detalhe em \texttt  {docs/analise\_cnn1dae\_exp13.md}.\relax }}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:categorias}{{5}{11}{Classificação automática dos 40 alarmes do período OOS por qualidade de detecção (metodologia de antecedência descrita no texto). Dos 40 alarmes, 4 são falhas confirmadas de comunicação/instrumento (\texttt {Comm Fail}/\texttt {Out of Serv} no dado bruto do SCADA), sem precursor físico esperado -- não removidos desta contagem para manter a comparação simples, mas documentados em detalhe em \texttt {docs/analise\_cnn1dae\_exp13.md}.\relax }{figure.caption.8}{}}
