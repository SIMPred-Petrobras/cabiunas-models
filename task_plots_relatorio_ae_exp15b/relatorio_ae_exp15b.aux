\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Antecedência da primeira detecção, alarme a alarme (40 alarmes OOS, ordem cronológica). Círculo azul = task~14; triângulo laranja = EXP15b; cor de preenchimento = categoria (Figura~\ref  {fig:categorias}). Linha vertical em 0 = instante do alarme. Ausência de marcador = alarme sem detecção naquele candidato.\relax }}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:leadtime}{{6}{12}{Antecedência da primeira detecção, alarme a alarme (40 alarmes OOS, ordem cronológica). Círculo azul = task~14; triângulo laranja = EXP15b; cor de preenchimento = categoria (Figura~\ref {fig:categorias}). Linha vertical em 0 = instante do alarme. Ausência de marcador = alarme sem detecção naquele candidato.\relax }{figure.caption.9}{}}
