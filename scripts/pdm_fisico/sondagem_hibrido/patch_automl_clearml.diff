+# 5º sinal, vindo PRE-COMPUTADO de fora (acrescentado 04/09/2026)
+# ----------------------------------------------------------------------
+# O `--with-vibration` existente injeta as 10 tags TV_* cruas como familia de
+# PCA, e essa construcao falha: o NIVEL das sondas deriva ao longo dos
+# trimestres e a normalizacao mensal nao remove essa deriva -- medido, 5/8 a
+# 2,48 FP/mes. O canal que funciona usa referencia ROLANTE de 400 h com banda
+# de guarda de 24 h, e essa referencia e parte do sinal, nao pre-processamento.
+# Por isso ele entra pronto, como coluna, em vez de ser derivado aqui.
+#
+# CRITICO: ja vem normalizado (z robusto, maximo das 10 sondas). Passa-lo pela
+# normalizacao mensal dos derivados aplicaria abs(vb - mediana), o que DOBRA a
+# distribuicao na mediana e mapeia amostra quieta para escore alto -- invertido.
+# Daí `PRE_NORMALIZADOS`: para esses o centro e 0 e a escala e 1.
+SINAL_EXTERNO_COL = "VB_ROLANTE_Z"
+SINAL_EXTERNO_NOME = "vibracao_z"
+PRE_NORMALIZADOS = {SINAL_EXTERNO_NOME}
+
+# Portao de canal obrigatorio (acrescentado 04/09/2026)
+# ----------------------------------------------------------------------
+# `confirm` exige N sinais simultaneos entre TODOS -- uma contagem. O detector
+# de 4 sinais do Thallys exige `voto >= 2 E (sp OU vb)`: contagem MAIS um canal
+# obrigatorio qualificado. A diferenca decide se um canal de limiar baixo e
+# utilizavel: medido, com o vb em p60 e `confirm=2` sem portao, NENHUMA das 48
+# configuracoes passa no teto de 1 FP/mes -- o canal fica aceso 40% do tempo e
+# qualquer segundo sinal fecha o voto. Com portao, o canal baixo so conta se
+# houver corroboracao QUALIFICADA.
+# Vazio = comportamento original (so a contagem).
+PORTAO_OBRIGATORIO: set[str] = set()
+
 PHYSICAL_RANGE = {"temperatura": (-15.0, 900.0), "pressao_oleo": (-1.5, 120.0),
                   "vibracao": (0.0, 200.0)}
