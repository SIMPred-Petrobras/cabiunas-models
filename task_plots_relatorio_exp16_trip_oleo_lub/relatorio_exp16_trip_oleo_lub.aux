\newlabel{sec:sanity}{{3.3}{5}{Sanity-check: o resultado é real, não artefato do conjunto pequeno}{subsection.3.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Resultados}{6}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Métricas do candidato final}{6}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Série completa de \texttt  {PI\_0308} (2024--2026) com os pontos sinalizados como anômalos pelo modelo final (pontos vermelhos) e os 3 eventos genuínos conhecidos do alarme \texttt  {PALL\_6240309} marcados. Os grandes trechos em torno de $-0{,}25$ a $-1{,}0$ correspondem a períodos com a turbina desligada (o sensor cai ao piso físico de leitura), excluídos da avaliação pela máscara operacional.\relax }}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:serie-completa}{{3}{6}{Série completa de \texttt {PI\_0308} (2024--2026) com os pontos sinalizados como anômalos pelo modelo final (pontos vermelhos) e os 3 eventos genuínos conhecidos do alarme \texttt {PALL\_6240309} marcados. Os grandes trechos em torno de $-0{,}25$ a $-1{,}0$ correspondem a períodos com a turbina desligada (o sensor cai ao piso físico de leitura), excluídos da avaliação pela máscara operacional.\relax }{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Gráfico do acerto: o caso genuinamente preditivo}{6}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Episódio de 2025-11-04: a turbina entra em operação às $\sim $13h50 do dia anterior; o \texttt  {iforest} sinaliza uma janela de anomalia (pontos vermelhos) já entre 16h04 e 17h07 desse mesmo dia -- $\sim $14,3 horas antes do trip (linha vermelha), pouco depois da partida. É um episódio (\emph  {burst}) concentrado logo após a partida, não uma tendência crescente ao longo de toda a janela; ainda assim, cai inteiramente antes do trip, contando como antecedência real -- diferente do padrão reativo descrito abaixo para os casos sem sinal.\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:caso-detectado}{{4}{7}{Episódio de 2025-11-04: a turbina entra em operação às $\sim $13h50 do dia anterior; o \texttt {iforest} sinaliza uma janela de anomalia (pontos vermelhos) já entre 16h04 e 17h07 desse mesmo dia -- $\sim $14,3 horas antes do trip (linha vermelha), pouco depois da partida. É um episódio (\emph {burst}) concentrado logo após a partida, não uma tendência crescente ao longo de toda a janela; ainda assim, cai inteiramente antes do trip, contando como antecedência real -- diferente do padrão reativo descrito abaixo para os casos sem sinal.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}O que não foi previsto, e por quê}{7}{subsection.4.3}\protected@file@percent }
\newlabel{sec:naodetectado}{{4.3}{7}{O que não foi previsto, e por quê}{subsection.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Os dois eventos sem sinal detectável. Em ambos os casos, \texttt  {PI\_0308} permanece completamente estável dentro da faixa normal até o instante exato (ou muito próximo) do trip -- não há degradação gradual visível em nenhum sensor disponível. No evento de 2024-03-07, o alarme dispara às 13h55 mas a queda física real só ocorre $\sim $2h depois (15h56), um detalhe curioso da sequência de proteção que não muda a conclusão: não há aviso prévio detectável em nenhum dos dois casos.\relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:nao-detectados}{{5}{8}{Os dois eventos sem sinal detectável. Em ambos os casos, \texttt {PI\_0308} permanece completamente estável dentro da faixa normal até o instante exato (ou muito próximo) do trip -- não há degradação gradual visível em nenhum sensor disponível. No evento de 2024-03-07, o alarme dispara às 13h55 mas a queda física real só ocorre $\sim $2h depois (15h56), um detalhe curioso da sequência de proteção que não muda a conclusão: não há aviso prévio detectável em nenhum dos dois casos.\relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.3.1}Duas hipóteses de precursor levantadas e refutadas}{8}{subsubsection.4.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces As duas hipóteses testadas, mostradas na linha do tempo completa. A Hipótese 1 (declínio de temperatura) ocorre com tanta frequência que é essencialmente ruído operacional. A Hipótese 2 (\texttt  {PDIT\_0305}) é rara e por isso mais promissora à primeira vista, mas ao ser incorporada de fato ao modelo (não apenas observada isoladamente), não mudou o resultado.\relax }}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:precursores}{{6}{9}{As duas hipóteses testadas, mostradas na linha do tempo completa. A Hipótese 1 (declínio de temperatura) ocorre com tanta frequência que é essencialmente ruído operacional. A Hipótese 2 (\texttt {PDIT\_0305}) é rara e por isso mais promissora à primeira vista, mas ao ser incorporada de fato ao modelo (não apenas observada isoladamente), não mudou o resultado.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Hipótese 1 -- declínio de temperatura do óleo/mancais.}{9}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Hipótese 2 -- elevação de \texttt  {PDIT\_0305} (pressão diferencial de vazamento de gás de selagem).}{9}{section*.10}\protected@file@percent }
